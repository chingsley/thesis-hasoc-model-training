# Copy to .env and adjust paths.

# Hugging Face repo (after upload), e.g. chingsley/afro-xlmr-joint-igbo-yoruba-hate
# Leave empty to use MODEL_PATH instead.
HF_MODEL_ID=

# Local checkpoint directory (HuggingFace Trainer save_pretrained output).
# On the lab server, find the latest run with:
#   ls -td runs/afro_xlmr_joint/joint_igbo_yoruba/* | head -1
MODEL_PATH=../model_training/runs/afro_xlmr_joint/joint_igbo_yoruba

# cpu | cuda | auto
INFERENCE_DEVICE=auto

# Optional: required only for uploading to Hugging Face Hub
# HF_TOKEN=
