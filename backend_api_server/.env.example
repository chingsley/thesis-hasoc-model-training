# Which published model family the backend loads. Switch this one line, then
# restart uvicorn: original = current Hub repos (already downloaded);
# merged = HF_MODEL_ID_*_MERGED (upload to NEW repos; do not overwrite original).
HF_MODEL_SET=original

# Per-language Hugging Face repos — original dataset (keep these IDs unchanged)
HF_MODEL_ID_IGBO=chingsley/afro-xlmr-igbo-hate
HF_MODEL_ID_YORUBA=chingsley/afro-xlmr-yoruba-hate
# Joint model: fallback when a language-specific model is missing, or for mixed-language batches via API ?language= is still igbo|yoruba — joint is not selected from the dashboard dropdown.
HF_MODEL_ID_JOINT=chingsley/afro-xlmr-joint-igbo-yoruba-hate

# Merged-dataset models (after retraining). Upload to new repos, then set
# HF_MODEL_SET=merged. Cached separately from the original downloads.
HF_MODEL_ID_IGBO_MERGED=chingsley/afro-xlmr-igbo-hate-v2-merged
HF_MODEL_ID_YORUBA_MERGED=chingsley/afro-xlmr-yoruba-hate-v2-merged
HF_MODEL_ID_JOINT_MERGED=chingsley/afro-xlmr-joint-igbo-yoruba-hate-v2-merged

# Local checkpoints (alternative to HF_MODEL_ID_* above)
# MODEL_PATH_IGBO=../runs/afro_xlmr_base/igbo/20260515_143652
# MODEL_PATH_YORUBA=../runs/afro_xlmr_base/yoruba/20260515_153329
# MODEL_PATH_JOINT=../runs/afro_xlmr_joint/joint_igbo_yoruba/20260515_151540

# Legacy single-model vars (used only if per-language vars are unset)
# HF_MODEL_ID=
# MODEL_PATH=../runs/afro_xlmr_base/igbo

# Test-set metrics for GET /metrics?language=igbo|yoruba
# Optional: if unset, the backend downloads test_metrics.json from the HF_MODEL_ID_* repo above
# (modeling.scripts.publish_to_hf pushes it alongside the checkpoint). Set these only to override with local files,
# e.g. on the training server before the metrics have been uploaded.
# METRICS_PATH_IGBO=../runs/afro_xlmr_base/igbo/20260515_143652/test_metrics.json
# METRICS_PATH_YORUBA=../runs/afro_xlmr_base/yoruba/20260515_153329/test_metrics.json
# METRICS_PATH_JOINT=../runs/afro_xlmr_joint/joint_igbo_yoruba/20260515_151540/test_metrics.json

# Posts for GET /posts, word cloud, clusters, incident report
# Optional: same HF fallback as metrics, using predictions_test.csv from the model repo.
# PREDICTIONS_PATH_IGBO=../runs/afro_xlmr_base/igbo/20260515_143652/predictions_test.csv
# PREDICTIONS_PATH_YORUBA=../runs/afro_xlmr_base/yoruba/20260515_153329/predictions_test.csv

# SQLite DB for users, API keys, sessions, triage state, prediction logs, alerts
# (default: backend_api_server/dashboard.db)
# DASHBOARD_DB_PATH=./dashboard.db

# Dashboard session token lifetime in hours (default: 168 = 7 days)
# SESSION_TTL_HOURS=168

# XAI tuning: LIME samples per explanation (higher = slower, more stable).
# LIME runs twice per request (stability metric), so this dominates /explain latency.
# EXPLAIN_LIME_SAMPLES=200
# Integrated-gradients interpolation steps
# EXPLAIN_IG_STEPS=32
# Thread-pool size for running the four XAI methods concurrently
# EXPLAIN_MAX_WORKERS=4

# Max newest Hate/Abuse posts used for the model-measured toxic-terms cloud
# (leave-one-out word removal; cost scales with posts x words)
# TOXIC_TERMS_MAX_POSTS=80

# Alert thresholds
# ALERT_HATE_HOUR_THRESHOLD=40
# ALERT_HATE_HOUR_HIGH=60
# ALERT_HIGH_CONF_HATE=0.9

INFERENCE_DEVICE=auto
CORS_ORIGINS=http://localhost:5173

# Hugging Face credentials. Required when the model repos above are private.
# Leave unset if the machine already has a login token in $HF_HOME (created by
# `hf auth login`); set it for environments without one, e.g. a systemd unit or
# a container, otherwise the first prediction fails with a 401.
# HF_TOKEN=
