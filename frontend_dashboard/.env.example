# Real backend (default). Set VITE_USE_MOCK=true to use in-memory mock data instead.
VITE_USE_MOCK=false

# Leave empty in dev to use the Vite proxy (/api -> backend).
# Set VITE_DEV_API_TARGET if the backend is not on http://127.0.0.1:8080
# (use 127.0.0.1, not localhost, when another app may bind the same port on IPv6).
# VITE_DEV_API_TARGET=http://127.0.0.1:8081
# In production, set to your deployed API URL, e.g. https://api.example.com
VITE_API_BASE_URL=
